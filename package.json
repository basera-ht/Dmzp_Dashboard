{
  "name": "root",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@app/client",
    "dev:server": "npm run dev --workspace=@app/server",
    "build": "npm run build --workspace=@app/client",
    "build:client": "npm run build --workspace=@app/client",
    "build:server": "npm run build --workspace=@app/server",
    "db:generate": "npm run db:generate --workspace=@app/server",
    "db:push": "npm run db:push --workspace=@app/server",
    "db:studio": "npm run db:studio --workspace=@app/server",
    "db:seed": "npm run db:seed --workspace=@app/server",
    "db:setup": "npm run db:setup --workspace=@app/server"
  }
}
